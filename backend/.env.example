# Banco local (docker compose up -d). Em produção, cole a URL do Neon.
DATABASE_URL="postgresql://waw:waw@localhost:5433/waw_orcamentos"

# Texto longo e aleatório usado para assinar os tokens de login.
JWT_SECRET="troque-por-um-texto-longo-e-aleatorio"

# Endereços do front-end que podem chamar a API, separados por vírgula.
FRONTEND_URL="http://localhost:5175"

# Chave da API da Claude (console.anthropic.com). Sem ela o sistema funciona, mas sem os dados de IA.
ANTHROPIC_API_KEY=""

# E-mail de resposta ao cliente. Sem SMTP_HOST a resposta é salva e o e-mail é ignorado.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="WAW Studio <contato@wawstudio.com.br>"

# Primeiro administrador, criado pelo seed (npm run seed). Credenciais de teste: troque em produção.
ADMIN_NOME="Equipe WAW"
ADMIN_EMAIL="admin@waw.test"
ADMIN_SENHA="waw-admin-2026"
